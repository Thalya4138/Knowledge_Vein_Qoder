{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-atlas.local/schemas/evidence.schema.json",
  "title": "LearningEvidence",
  "description": "学习证据与用户自评。落盘在 evidence/*.json，不属于 layouts/。掌握状态只能来自这里的练习记录或用户自评，不来自阅读次数；userSelfReport 优先级高于任何自动推断。",
  "type": "object",
  "required": ["schemaVersion", "kbId", "evidence"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "kbId": { "type": "string", "pattern": "^kb\\.[a-z0-9-]+$" },
    "note": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "userSelfReport": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": { "pattern": "^(n\\.[a-z0-9-]+|note)$" },
      "patternProperties": {
        "^n\\.": { "type": "string", "enum": ["recall", "understand", "apply"] }
      },
      "description": "节点 id → 自评掌握层级。note 键用来写说明文字。"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id", "targetIds", "task", "response", "score", "date"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^ev\\.[0-9a-z-]+$" },
        "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^n\\.[a-z0-9-]+$" } },
        "task": { "type": "string", "minLength": 1, "description": "做的是什么：练习 / 隐藏重建 / 反例检验 / 迁移题。" },
        "response": { "type": "string", "minLength": 1, "description": "用户的实际作答，原样记录，不美化。" },
        "rubric": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "score": {
          "type": "object",
          "required": ["recall", "understand", "apply"],
          "additionalProperties": false,
          "properties": {
            "recall": { "type": "boolean" },
            "understand": { "type": "boolean" },
            "apply": { "type": "boolean" }
          },
          "description": "记得 / 理解 / 会用是三件事，必须分开记。"
        },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    }
  }
}
