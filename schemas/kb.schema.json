{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-atlas.local/schemas/kb.schema.json",
  "title": "KnowledgeBase",
  "description": "一个知识库。粒度由用户决定：整个学科（discipline）/ 一门课（course）/ 一个专题（topic）。落盘即一个目录，可被 Obsidian / Git / 纯文本编辑器直接使用。",
  "type": "object",
  "required": ["schemaVersion", "kbId", "title", "level", "outline"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string" },
    "kbId": { "type": "string", "pattern": "^kb\\.[a-z0-9-]+$", "description": "与 graph.schema.json / manifest.schema.json 同一个键名；代码里的类型名是 KnowledgeBase。" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "level": {
      "type": "string",
      "enum": ["discipline", "course", "topic"],
      "description": "学科 / 课程 / 专题。决定 UI 的默认导航粒度，不影响数据结构。"
    },
    "parentKbId": {
      "type": ["string", "null"],
      "description": "若本知识库属于更大的知识库（如「线性代数」属于「数学」），填写父级 id。"
    },
    "childKbIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "学科级知识库可挂多个课程级知识库。"
    },
    "locale": { "type": "string" },
    "levelLabel": { "type": "string", "description": "面向读者的难度说明，如「本科一年级」。" },
    "license": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^(ch|sec)\\.[0-9a-z-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["written", "planned"], "description": "planned = 只有图谱节点、尚无讲义" },
          "notePath": { "type": ["string", "null"], "pattern": "\\.md$", "description": "status=written 时必填" },
          "rendered": { "type": "string", "description": "可选：期望渲染结果（手工样张），用于阅读器验收" },
          "goal": { "type": "string" },
          "prereqIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "learningPath": { "type": "object", "additionalProperties": true },
    "resourceIds": { "type": "array", "items": { "type": "string" } },
    "nodeIds": { "type": "array", "items": { "type": "string" } },
    "integrity": {
      "type": "object",
      "additionalProperties": true,
      "description": "本知识库自带的完整性声明（例如「每条 [[wiki link]] 必须落到节点」）。只是给人看的说明，真正的强制在 scripts/verify-content.mjs。",
      "properties": { "note": { "type": "string" } }
    }
  }
}
